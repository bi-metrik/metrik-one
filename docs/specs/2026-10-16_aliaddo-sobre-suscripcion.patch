+/**
+ * La factura electrónica automática (Aliaddo) de un cobro de SUSCRIPCIÓN (`suscripciones_producto`,
+ * desde 20261016): el barrido la encuentra por el origen de la suscripción, la decisión la ve
+ * facturable (contrato, módulo y origen automático) y el comprador es la empresa declarada. Un cobro de
+ * negocio con el mismo origen se sigue encolando igual. Nada sale a Muisca: la fila nace sin estado de
+ * trabajo en el doble y el paso 2 no la toma.
+ */
+import { describe, expect, it, vi } from 'vitest'
+import { crearDoble, type Tablas } from '../../../test/tablas-doble'
+
+vi.mock('server-only', () => ({}))
+vi.mock('@/lib/supabase/server', () => ({ createServiceClient: () => null }))
+
+const { procesarFacturasPendientes } = await import('./emision-servidor')
+
+const WS = 'a21bfc88-1a60-48c3-afcd-144226aa2392'
+const ENV = {
+  FACTURACION_ELECTRONICA_HABILITADA: '1',
+  ALIADDO_TOKEN: 'token-de-prueba',
+  ALIADDO_MODO: 'Test',
+  ALIADDO_EMISOR_WORKSPACE_ID: WS,
+  FACTURACION_ELECTRONICA_DESDE: '2026-10-01',
+}
+
+function tablas(): Tablas {
+  return {
+    catalogo_servicios: [{ slug: 'valida-cda-licencia', modulo: 'valida_consulta' }],
+    negocios: [{ id: 'n1', workspace_id: WS, metadata: { origen: 'valida_autogestion' } }],
+    empresas: [{ id: 'e1', razon_social: 'VIEJO S.A.S.', numero_documento: '900158425-0' }],
+    suscripciones_producto: [
+      {
+        id: 's1', workspace_id: WS, metadata: { origen: 'valida_autogestion' }, razon_social: 'CDA EJEMPLO S.A.S.',
+        tipo_documento: 'NIT', numero_documento: '900123456', dv: '7', correo_facturacion: 'facturas@cda.co', datos_fiscales: {},
+      },
+    ],
+    servicios_contratados: [
+      { id: 'sc-n', workspace_id: WS, negocio_id: 'n1', suscripcion_id: null, empresa_id: 'e1', correo_facturacion: 'a@b.co', servicio_slug: 'valida-cda-licencia' },
+      { id: 'sc-s', workspace_id: WS, negocio_id: null, suscripcion_id: 's1', empresa_id: null, correo_facturacion: null, servicio_slug: 'valida-cda-licencia' },
+    ],
+    cobros: [
+      { id: 'c-sus', workspace_id: WS, negocio_id: null, suscripcion_id: 's1', monto: 150000, fecha: '2026-10-20', anulado_at: null, plan_cobro_id: null, numero_cuota: null, external_ref: 'epayco-1' },
+      { id: 'c-neg', workspace_id: WS, negocio_id: 'n1', suscripcion_id: null, monto: 150000, fecha: '2026-10-20', anulado_at: null, plan_cobro_id: null, numero_cuota: null, external_ref: 'epayco-2' },
+    ],
+    facturas_cobro: [],
+    facturas_cuota: [],
+    facturas_electronicas: [],
+  }
+}
+
+describe('factura electrónica automática de un cobro de suscripción', () => {
+  it('el barrido encola el cobro de la suscripción y el del negocio, sin errores', async () => {
+    const d = crearDoble(tablas())
+    const r = await procesarFacturasPendientes({ db: d.db, env: ENV })
+    expect(r.estado).toBe('corrida')
+    expect(r.errores).toEqual([])
+    expect(r.encoladas).toBe(2)
+    expect(d.tablas.facturas_electronicas.map((f) => f.cobro_id).sort()).toEqual(['c-neg', 'c-sus'])
+  })
+
+  it('una suscripción con otro origen no se factura sola', async () => {
+    const t = tablas()
+    t.suscripciones_producto[0].metadata = { origen: 'directo_ventas' }
+    t.cobros = t.cobros.filter((c) => c.id === 'c-sus')
+    const d = crearDoble(t)
+    const r = await procesarFacturasPendientes({ db: d.db, env: ENV })
+    expect(r.estado).toBe('corrida')
+    expect(r.encoladas).toBe(0)
+    expect(d.tablas.facturas_electronicas).toEqual([])
+  })
+})
